# Application origin used for links, invitations, and canonical metadata.
NEXT_PUBLIC_SITE_URL=https://app.sociasdigitales.com

# App-specific Supabase project. Never reuse the marketing project's keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email provider (server-side only).
RESEND_API_KEY=
RESEND_FROM=

# Videos privados de Cloudflare R2 (servidor únicamente; bucket sd-desafio-socias-videos).
R2_S3_ACCOUNT_ID=
R2_BUCKET_NAME=sd-desafio-socias-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Push notifications (keep the private key server-side only).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@sociasdigitales.com
